(dataset contains 0 observations)
(file /tmp/St00028.000002 not found)
file /tmp/St00028.000002 saved as .dta format

. 
. * ======================================================================
. * loop over years
. * ======================================================================
. 
. forvalues y = `firstyear'/`lastyear' {
  2. 
.         di as text _n "{hline 60}" _n "QCEW `y'" _n "{hline 60}"
  3. 
.         capture confirm file "`csvdir'/`y'.annual.singlefile.csv"
  4.         if _rc != 0 {
  5.                 di as error "missing csv for `y' -- skipping"
  6.                 continue
  7.         }
  8. 
.         * --- read ----------------------------------------------------------
.         import delimited "`csvdir'/`y'.annual.singlefile.csv", varnames(1) clear
  9. 
.         keep area_fips own_code industry_code agglvl_code year ///
>                  annual_avg_estabs annual_avg_emplvl total_annual_wages ///
>                  annual_avg_wkly_wage
 10. 
.         * area_fips and industry_code hold non-numeric values (MSA/national
.         * codes; sector codes such as "31-33"), so they normally import as
.         * strings. Force it in case a given vintage reads as numeric.
.         capture confirm string variable area_fips
 11.         if _rc != 0 tostring area_fips, replace format(%05.0f)
 12.         capture confirm string variable industry_code
 13.         if _rc != 0 tostring industry_code, replace
 14. 
.         * --- steps 1-4: row selection --------------------------------------
.         keep if own_code == 5
 15.         keep if inlist(agglvl_code, 74, 76)
 16.         drop if strpos(area_fips, "999")
 17.         drop if annual_avg_emplvl == 0
 18. 
.         * --- step 5: county -> 1990 commuting zone -------------------------
.         destring area_fips, gen(fips) force
 19.         merge m:1 fips using "`czfile'", keepusing(cz1990) keep(master match) nogen
 20. 
.         save "`yr'", replace
 21. 
.         * --- step 6a: NAICS 4-digit panel ----------------------------------
.         use "`yr'", clear
 22.         keep if agglvl_code == 76
 23.         rename industry_code naics4
 24.         gcollapse (rawsum) emp = annual_avg_emplvl        ///
>                            est = annual_avg_estabs        ///
>                            wage = total_annual_wages      ///
>                   (mean)   annual_avg_wkly_wage           ///
>                   [aw = annual_avg_emplvl], by(year naics4 cz1990)
 25.         append using "`n4'"
 26.         save "`n4'", replace
 27. 
.         * --- step 6b: NAICS sector panel -----------------------------------
.         use "`yr'", clear
 28.         keep if agglvl_code == 74
 29.         rename industry_code naics2
 30.         gcollapse (rawsum) emp = annual_avg_emplvl        ///
>                            est = annual_avg_estabs        ///
>                            wage = total_annual_wages      ///
>                   (mean)   annual_avg_wkly_wage           ///
>                   [aw = annual_avg_emplvl], by(year naics2 cz1990)
 31.         append using "`n2'"
 32.         save "`n2'", replace
 33. }

