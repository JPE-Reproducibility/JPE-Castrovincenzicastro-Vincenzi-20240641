 17.                 local x = real(`v'[`mrow'])
 18.                 if !missing(`y') & `y' >= 1900 & `y' <= 2100 & !missing(`x') {
 19.                         post `M' (`y') (`x')
 20.                 }
 21.         }
 22.         postclose `M'
