. * Import and reduce one 2002/2007/2012 Census table.
. capture program drop _census_modern

. program define _census_modern
  1.         syntax, FILE(string) YEAR(integer) MFG(integer) OUTFILE(string)
  2. 
. * Import as text first: this preserves the published decimal strings before
. * the explicit numeric conversions below.  Stata otherwise chooses float
. * storage for several columns while importing delimited text.
.         import delimited using "`file'", clear varnames(1) stringcols(_all)
  3.         rename *, upper
  4. 
.         local naics NAICS`year'
  5.         gen str9 naics6 = strtrim(`naics')
  6.         replace naics6 = strtrim(naics6)
  7. 
.         * The source files contain industry aggregates and product-line detail.
.         * Retain six-character NAICS industries only.
.         keep if strlen(naics6) == 6
  8. 
.         * Some subject-series releases repeat data by tax status.  Retain the
.         * all-establishments universe (00 where available, otherwise A).
.         capture confirm variable OPTAX
  9.         if !_rc {
 10.                 quietly count if strtrim(OPTAX) == "00"
 11.                 if r(N) > 0 keep if strtrim(OPTAX) == "00"
 12.                 else        keep if strtrim(OPTAX) == "A"
 13.         }
 14. 
.         * Preserve the numeric precision published in the Census source files.
.         local share VAL_PCT
 15.         if `mfg' == 1 local share CCORCPPCT
 16.         if `year' == 2002 & `mfg' == 0 local share VALPCT
 17. 
.         gen double company = .
 18.         gen double sales = real(RCPTOT)
 19.         gen double cr4 = .
 20.         gen double cr8 = .
 21.         gen double cr20 = .
 22.         gen double cr50 = .
 23.         gen double hhi50 = .
 24.         gen double estab = .
 25. 
.         capture confirm variable RCPTOT_F
 26.         if !_rc replace sales = . if strtrim(RCPTOT_F) != ""
 27. 
.         capture confirm variable ESTAB
 28.         if !_rc {
 29.                 replace estab = real(ESTAB)
 30.                 capture confirm variable ESTAB_F
 31.                 if !_rc replace estab = . if strtrim(ESTAB_F) != ""
 32.         }
 33. 
.         if `mfg' == 1 {
 34.                 replace company = real(COMPANY)
 35.                 local companyflag COMPANY_F
 36.                 capture confirm variable `companyflag'
 37.                 if _rc local companyflag COMPANYF
 38.                 capture confirm variable `companyflag'
 39.                 if !_rc replace company = . if strtrim(`companyflag') != ""
 40. 
.                 * Retain the HHI value at its published decimal precision.
.                 replace hhi50 = real(VSHERFI)
 41.                 capture confirm variable VSHERFI_F
 42.                 if !_rc replace hhi50 = . if strtrim(VSHERFI_F) != ""
 43.         }
 44. 
.         gen double _share = real(`share')
 45.         capture confirm variable `share'_F
 46.         if !_rc replace _share = . if strtrim(`share'_F) != ""
 47.         gen str3 _concenfi = strtrim(CONCENFI)
 48.         replace _concenfi = strtrim(_concenfi)
 49.         replace cr4  = _share if inlist(_concenfi, "804", "856")
 50.         replace cr8  = _share if inlist(_concenfi, "808", "857")
 51.         replace cr20 = _share if inlist(_concenfi, "820", "858")
 52.         replace cr50 = _share if inlist(_concenfi, "850", "859")
 53. 
.         drop _share _concenfi
 54.         collapse (max) company sales cr4 cr8 cr20 cr50 hhi50 estab, by(naics6)
 55.         gen float year = `year'
 56.         sort naics6 year
 57.         save "`outfile'", replace
 58. end

